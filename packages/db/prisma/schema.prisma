generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  email_verified Boolean
  aut_method     AuthMethod
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  profiles       Profile?
}

model Profile {
  user_id    String  @id
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  avatar_url String?
  first_name String?
  last_name  String?
}

enum AuthMethod {
  email
  google
}
